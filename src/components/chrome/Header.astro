---
/**
 * PrivoLabs — Header
 * Source: 02-DESIGN-SYSTEM.md §3.5, 3.6, 3.7
 *
 * Sticky header. Hides on scroll down (>400px), reveals on scroll up.
 * Contains wordmark, main nav links, and theme toggle.
 */

import ThemeToggle from './ThemeToggle.tsx';

const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => currentPath === path || (path !== '/' && currentPath.startsWith(path));
---

<header id="site-header" data-state="top">
  <div class="container header-inner">
    {/* Wordmark */}
    <a href="/" class="wordmark" aria-label="PrivoLabs Home">
      <img class="logo-img" alt="PrivoLabs" />
    </a>

    {/* Desktop Navigation */}
    <nav class="desktop-nav" aria-label="Main Navigation">
        <ul class="nav-list">
          <li><a href="/ai" class="nav-link label" aria-current={isCurrent('/ai') ? 'page' : undefined}>AI</a></li>
          <li class="has-dropdown">
            <a href="/services" class="nav-link label" aria-haspopup="true" aria-expanded="false" aria-current={isCurrent('/services') ? 'page' : undefined}>Services</a>
            <div class="dropdown-menu">
              <ul class="dropdown-list">
                <li><a href="/services/custom-development" class="dropdown-link">Custom Development</a></li>
                <li><a href="/services/cloud-platform" class="dropdown-link">Cloud Platform</a></li>
                <li><a href="/services/mobile-app-development" class="dropdown-link">Mobile App Dev</a></li>
                <li><a href="/services/quality-engineering" class="dropdown-link">Quality Engineering</a></li>
              </ul>
            </div>
          </li>
          <li><a href="/team" class="nav-link label" aria-current={isCurrent('/team') ? 'page' : undefined}>Team</a></li>
          <li><a href="/contact" class="nav-link label" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a></li>
        </ul>
    </nav>

    {/* Right Actions */}
    <div class="header-actions">
      <ThemeToggle client:only="react" />
      <button class="mobile-menu-toggle" aria-expanded="false" aria-label="Toggle mobile menu" aria-controls="mobile-nav">
        <svg class="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="12" x2="21" y2="12" class="line-middle" />
          <line x1="3" y1="6" x2="21" y2="6" class="line-top" />
          <line x1="3" y1="18" x2="21" y2="18" class="line-bottom" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Navigation Drawer */}
  <nav id="mobile-nav" class="mobile-nav" aria-hidden="true">
    <ul class="mobile-nav-list">
      <li><a href="/ai" class="mobile-nav-link heading" aria-current={isCurrent('/ai') ? 'page' : undefined}>AI</a></li>
      <li><a href="/services" class="mobile-nav-link heading" aria-current={isCurrent('/services') ? 'page' : undefined}>Services</a></li>
      <li><a href="/work" class="mobile-nav-link heading" aria-current={isCurrent('/work') ? 'page' : undefined}>Work</a></li>
      <li><a href="/technologies" class="mobile-nav-link heading" aria-current={isCurrent('/technologies') ? 'page' : undefined}>Tech</a></li>
      <li><a href="/insights" class="mobile-nav-link heading" aria-current={isCurrent('/insights') ? 'page' : undefined}>Insights</a></li>
      <li><a href="/team" class="mobile-nav-link heading" aria-current={isCurrent('/team') ? 'page' : undefined}>Team</a></li>
      <li><a href="/contact" class="mobile-nav-link heading" aria-current={isCurrent('/contact') ? 'page' : undefined}>Contact</a></li>
    </ul>
  </nav>
</header>

<script>
  // §3.5 Header scroll choreography
  const header = document.getElementById('site-header');
  if (header) {
    let last = 0;
    let ticking = false;
    
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      
      requestAnimationFrame(() => {
        const y = window.scrollY;
        
        // Determine state
        let state = 'top';
        if (y > 80) {
          if (y > last && y > 400) {
            state = 'hidden';
          } else {
            state = 'scrolled';
          }
        }
        
        if (header.dataset.state !== state) {
          header.dataset.state = state;
        }
        
        last = y;
        ticking = false;
      });
    }, { passive: true });
  }
  // Mobile Menu Toggle
  const menuToggle = document.querySelector('.mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  if (menuToggle && mobileNav) {
    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.setAttribute('aria-hidden', String(isExpanded));
      
      // Prevent body scrolling when menu is open
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    });
  }
</script>

<style>
  /* Header Layout */
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: transform var(--t-quick) var(--ease-out),
                background-color var(--t-fast) var(--ease-out),
                height var(--t-fast) var(--ease-out),
                border-color var(--t-fast) var(--ease-out);
    height: 96px;
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Scrolled State */
  header[data-state="scrolled"] {
    height: 64px;
    background-color: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--rule);
  }

  /* Hidden State */
  header[data-state="hidden"] {
    height: 64px;
    background-color: color-mix(in srgb, var(--surface) 72%, transparent);
    border-bottom-color: var(--rule);
    transform: translateY(-100%);
  }

  /* Wordmark */
  .wordmark {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    transition: opacity var(--t-fast) var(--ease-out);
  }

  .logo-img {
    height: 32px;
    width: auto;
    content: url('/logo.svg');
    display: block;
    transition: filter var(--t-base) var(--ease-out);
  }

  :global([data-theme='dark']) .logo-img {
    filter: drop-shadow(0 0 24px rgba(255, 255, 255, 1)) drop-shadow(0 0 10px rgba(255, 255, 255, 1)) drop-shadow(0 0 2px rgba(255, 255, 255, 1));
  }

  .wordmark:hover {
    opacity: 0.8;
  }

  /* Navigation Links §3.7 */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    gap: var(--s-6);
  }

  .nav-link {
    position: relative;
    color: var(--text-muted);
    transition: color var(--t-fast) var(--ease-out);
    padding: var(--s-2) 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -4px;
    height: 1px;
    width: 100%;
    background: var(--brand-500);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform var(--t-quick) var(--ease-out);
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  /* Active page state */
  .nav-link[aria-current="page"] {
    color: var(--text);
  }

  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  /* Dropdown Styles */
  .has-dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    padding-top: var(--s-2); /* Hover bridge */
    opacity: 0;
    visibility: hidden;
    transition: all var(--t-fast) var(--ease-out);
    pointer-events: none;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%);
    pointer-events: auto;
  }

  .has-dropdown:hover > .nav-link,
  .has-dropdown:focus-within > .nav-link {
    color: var(--text);
  }

  .has-dropdown:hover > .nav-link::after,
  .has-dropdown:focus-within > .nav-link::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .dropdown-list {
    background-color: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--r-md);
    padding: var(--s-2) 0;
    min-width: 240px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    transform: translateY(8px);
    transition: transform var(--t-fast) var(--ease-out);
  }
  
  .has-dropdown:hover .dropdown-list,
  .has-dropdown:focus-within .dropdown-list {
    transform: translateY(0);
  }

  [data-theme="light"] .dropdown-list {
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }

  .dropdown-link {
    display: block;
    padding: var(--s-2) var(--s-4);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: var(--body);
    font-weight: 500;
    transition: color var(--t-fast) var(--ease-out),
                background-color var(--t-fast) var(--ease-out);
    white-space: nowrap;
    text-decoration: none;
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    color: var(--text);
    background-color: var(--surface-hover);
  }

  /* Mobile Menu Button */
  .mobile-menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: var(--text);
    cursor: none; /* Relies on custom cursor */
    padding: var(--s-2);
    margin-right: calc(var(--s-2) * -1);
    z-index: 101;
    position: relative;
  }

  @media (min-width: 768px) {
    .mobile-menu-toggle {
      display: none;
    }
  }

  .hamburger-icon {
    transition: transform var(--t-fast) var(--ease-out);
  }

  .hamburger-icon line {
    transition: transform var(--t-fast) var(--ease-out), opacity var(--t-fast) var(--ease-out);
    transform-origin: center;
  }

  .mobile-menu-toggle[aria-expanded="true"] .line-top {
    transform: translateY(6px) rotate(45deg);
  }
  
  .mobile-menu-toggle[aria-expanded="true"] .line-middle {
    opacity: 0;
  }
  
  .mobile-menu-toggle[aria-expanded="true"] .line-bottom {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile Navigation Drawer */
  .mobile-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100dvh;
    background-color: var(--surface);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--gutter);
    opacity: 1;
    visibility: visible;
    transition: opacity var(--t-base) var(--ease-out), visibility var(--t-base) var(--ease-out);
  }

  .mobile-nav[aria-hidden="true"] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .mobile-nav-link {
    font-size: clamp(2.5rem, 8vw, 4rem);
    color: var(--text-muted);
    text-decoration: none;
    display: block;
    transition: color var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out);
    transform: translateY(0);
  }

  .mobile-nav[aria-hidden="true"] .mobile-nav-link {
    transform: translateY(16px);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link[aria-current="page"] {
    color: var(--text);
  }
  
  @media (min-width: 768px) {
    .mobile-nav {
      display: none !important;
    }
  }
</style>
