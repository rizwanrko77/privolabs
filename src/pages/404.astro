---
/**
 * PrivoLabs — 404 Page
 * Source: 02-DESIGN-SYSTEM.md §3.32
 *
 * Typographic 404 page with oscillating width animation.
 */

import Page from '../layouts/Page.astro';
---

<Page title="404 — Page Not Found" description="The page you are looking for does not exist." noIndex={true}>
  <section class="not-found-section">
    <div class="container text-center">
      <h1 class="error-code font-display text-brand">404</h1>
      <p class="error-msg font-mono label text-muted mt-8">
        THE REQUESTED RESOURCE COULD NOT BE LOCATED
      </p>
      <div class="mt-8">
        <a href="/" class="btn-primary" style="text-decoration:none">Return Home</a>
      </div>
    </div>
  </section>
</Page>

<style>
  .not-found-section {
    min-height: calc(100vh - 96px); /* account for header */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-11) 0;
  }

  .text-center {
    text-align: center;
  }

  .error-code {
    font-size: clamp(8rem, 25vw, 16rem);
    line-height: 0.8;
    margin: 0;
    font-weight: 800;
    letter-spacing: -0.04em;
    animation: wdth-oscillate 6s ease-in-out infinite;
  }

  @keyframes wdth-oscillate {
    0%, 100% { font-variation-settings: 'wdth' 100; }
    50%      { font-variation-settings: 'wdth' 75; }
  }

  .mt-8 {
    margin-top: var(--s-8);
  }

  .btn-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--on-accent);
    font: 500 var(--label)/1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: var(--s-4) var(--s-6);
    border-radius: var(--r-md);
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--t-fast) var(--ease-snap),
                background var(--t-fast) var(--ease-out);
    cursor: pointer;
  }
  
  .btn-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, transparent 20%, rgb(255 255 255 / 0.28) 50%, transparent 80%);
    transform: translateX(-100%);
    transition: transform var(--t-slow) var(--ease-out);
  }
  
  .btn-primary:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }
  
  .btn-primary:hover::before {
    transform: translateX(100%);
  }
  
  .btn-primary:active {
    transform: translateY(0) scale(0.98);
    background: var(--accent-press);
    transition-duration: var(--t-instant);
  }
  
  .btn-primary:focus-visible {
    outline: 2px solid var(--brand-500);
    outline-offset: 3px;
  }
</style>
