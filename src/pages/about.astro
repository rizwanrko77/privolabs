---
/**
 * PrivoLabs — About Page
 * Source: 01-ARCHITECTURE.md §3, 03-CONTENT.md §9.1
 */

import Page from '../layouts/Page.astro';
import { tokens } from '../data/tokens';
---

<Page 
  title="About PrivoLabs — Shipping since 2006" 
  description="PrivoLabs Technologies was founded by an engineer who spent two decades building and leading enterprise software delivery. That history is why we're careful about AI rather than breathless about it."
>
  <section class="hero-section container">
    <div class="hero-content">
      <h1 class="font-display heading hero-heading">{tokens.YEARS_EXPERIENCE} years of shipping, now pointed at AI</h1>
      <p class="font-body text-large hero-subhead">
        PrivoLabs Technologies was founded by an engineer who spent two decades building and leading enterprise software delivery. That history is why we're careful about AI rather than breathless about it.
      </p>
    </div>
  </section>
  
  <section class="founder-section container">
    <div class="founder-card bg-surface-alt">
      <div class="founder-content">
        <h2 class="font-display heading">{tokens.FOUNDER_NAME}</h2>
        <p class="label text-muted">{tokens.FOUNDER_ROLE}</p>
        <p class="font-body mt-4">
          Leading engineering with a focus on systems architecture and delivery leadership.
        </p>
        <div class="mt-6">
          <a href={tokens.FOUNDER_LINKEDIN} class="text-link" target="_blank" rel="noopener noreferrer">View on LinkedIn &rarr;</a>
        </div>
      </div>
      <div class="founder-photo">
        {tokens.FOUNDER_PHOTO !== '{{FOUNDER_PHOTO}}' ? (
          <img src={tokens.FOUNDER_PHOTO} alt={tokens.FOUNDER_NAME} />
        ) : (
          <div class="photo-placeholder">{tokens.FOUNDER_NAME.charAt(0)}</div>
        )}
      </div>
    </div>
  </section>

  <section class="beliefs-section container">
    <div class="section-header">
      <h2 class="font-display heading">How we work together</h2>
    </div>
    <div class="grid beliefs-grid">
      <div class="belief-item">
        <h3 class="label">Boring is a compliment.</h3>
        <p class="font-body">Systems should be unremarkable to operate. Excitement in production is a failure mode.</p>
      </div>
      <div class="belief-item">
        <h3 class="label">The trade-off is the answer.</h3>
        <p class="font-body">Every technical decision costs something. We name it before committing.</p>
      </div>
      <div class="belief-item">
        <h3 class="label">We inherit our own work.</h3>
        <p class="font-body">We design for the engineer who takes over in three years, because it's often us.</p>
      </div>
      <div class="belief-item">
        <h3 class="label">Say no early.</h3>
        <p class="font-body">Declining a project we're wrong for is cheaper for everyone than discovering it in month four.</p>
      </div>
    </div>
  </section>

  <section class="cta-section container bg-surface-alt">
    <div class="cta-content">
      <h2 class="font-display heading">Meet the rest of the team</h2>
      <p class="font-body mt-2">No account managers between you and the engineers. The people on the first call are the people writing the code.</p>
      <a href="/team" class="btn btn-secondary mt-6">View the team &rarr;</a>
    </div>
  </section>
</Page>

<style>
  section {
    padding-top: var(--s-12);
    padding-bottom: var(--s-12);
  }

  .hero-section {
    padding-top: var(--s-14);
  }

  .section-header {
    margin-bottom: var(--s-8);
  }

  .hero-heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    margin: var(--s-4) 0 var(--s-6);
    max-width: 800px;
  }

  .hero-subhead {
    max-width: 720px;
    margin-bottom: var(--s-8);
    color: var(--text-muted);
  }

  .founder-card {
    display: grid;
    grid-template-columns: 1fr;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  
  @media (min-width: 768px) {
    .founder-card {
      grid-template-columns: 3fr 2fr;
    }
  }

  .founder-content {
    padding: var(--s-8) var(--s-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .founder-photo {
    min-height: 300px;
    background-color: var(--surface-float);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .founder-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo-placeholder {
    font-family: var(--font-display);
    font-size: 5rem;
    color: var(--brand-500);
  }

  .grid {
    display: grid;
    gap: var(--s-8);
  }

  .beliefs-grid {
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .belief-item {
    border-top: 2px solid var(--rule);
    padding-top: var(--s-4);
  }

  .belief-item h3 {
    margin-bottom: var(--s-2);
    color: var(--text);
  }

  .belief-item p {
    color: var(--text-muted);
  }

  .cta-section {
    padding: var(--s-12) var(--s-8);
    border-radius: var(--r-lg);
    margin-bottom: var(--s-12);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--s-6);
    height: 48px;
    border-radius: var(--r-md);
    font-weight: 500;
    text-decoration: none;
    transition: all var(--t-fast) var(--ease-out);
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: var(--brand-500);
    color: var(--brand-500);
  }
  
  .text-link {
    display: inline-block;
    color: var(--brand-500);
    font-weight: 500;
    text-decoration: none;
  }
  
  .text-link:hover {
    text-decoration: underline;
  }

  .bg-surface-alt {
    background-color: var(--surface-alt);
  }

  .mt-2 { margin-top: var(--s-2); }
  .mt-4 { margin-top: var(--s-4); }
  .mt-6 { margin-top: var(--s-6); }
</style>
